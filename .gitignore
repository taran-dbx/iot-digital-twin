# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Node
node_modules/

# IDE
.idea/
.vscode/
*.swp

# Databricks
.databricks/
.databricks-resources.json
.claude/
.claude-terminal
.superpowers/
.coverage

# OS
.DS_Store

# Project-specific exclusions
screenshots/
qa-reports/
docs/architecture/*.architecture.html
# Design-reference mockups — kept on disk as reference, out of the repo.
mockups/
# Anchored with a leading slash so only the top-level notebooks/ (legacy Spark
# job sources) is excluded; databricks/ (vendor/lakets.sql) stays tracked.
# NOTE: the LakeTS ops notebooks are inlined in services/lakets_deploy_service.py,
# not read from disk — there is no databricks/notebooks/ dir.
/notebooks/
capture_screenshots.py
# Client (React/Vite) source is tracked; ignore its deps and generated output.
# The production build goes to ../static/dist (tracked, see note below).
client/node_modules
client/dist/
client/test-results/
client/playwright-report/
client/coverage/
client/.ruff_cache/
client/.vite/
client/*.tsbuildinfo
client/.env*
client/*.local
# NOTE: static/dist/ is NOT gitignored — databricks sync honours gitignore
# patterns, so excluding it here means the frontend bundle never reaches the
# deployed app.  Keep untracked in git via individual file ignores if needed,
# but do not add the directory to gitignore.
