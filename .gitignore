# Project-specific exclusions
screenshots/
# Anchored with leading slash so only the top-level notebooks/ (legacy
# Spark job sources) is excluded — databricks/notebooks/ must remain
# synced because lakets_deploy_service uploads lakets_retention.py from there.
/notebooks/
capture_screenshots.py
client/
# NOTE: static/dist/ is NOT gitignored — databricks sync honours gitignore
# patterns, so excluding it here means the frontend bundle never reaches the
# deployed app.  Keep untracked in git via individual file ignores if needed,
# but do not add the directory to gitignore.
