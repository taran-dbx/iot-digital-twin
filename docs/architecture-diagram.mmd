    %% STYLES
    %% ══════════════════════════════════════════════════
    classDef user    fill:#1e293b,stroke:#94a3b8,stroke-width:2px,color:#f1f5f9,font-weight:bold
    classDef fe      fill:#1d4ed8,stroke:#93c5fd,stroke-width:1px,color:#dbeafe
    classDef auth    fill:#92400e,stroke:#fcd34d,stroke-width:2px,color:#fef3c7,font-weight:bold
    classDef be      fill:#166534,stroke:#86efac,stroke-width:1px,color:#dcfce7
    classDef sink    fill:#0e7490,stroke:#67e8f9,stroke-width:1px,color:#cffafe
    classDef storage fill:#9a3412,stroke:#fb923c,stroke-width:1px,color:#ffedd5
    classDef ext     fill:#6b21a8,stroke:#c084fc,stroke-width:1px,color:#ede9fe

    class USER user
    class P_HOME,P_DASH,P_WIZ,P_DET,P_HUB,P_SRC,FE_CTX,WS_HOOK,CHARTS fe
    class AUTH auth
    class A_PIP,A_SEN,A_PRO,A_CLU,A_SSS,WS_EP,BCAST,SIM,METRICS be
    class SK_WS,SK_LB,SK_ZB sink
    class T_PIP,T_SEN,MV1,MV2,DELTA,UC storage
    class SSS_SRC,SSS_JOB,SSS_FW,DBK_SDK,DBK_API,DBK_KAF ext
