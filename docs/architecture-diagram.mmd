    %% ══════════════════════════════════════════════════
    %% USER
    %% ══════════════════════════════════════════════════
    USER(["👤 Browser User"])

    %% ══════════════════════════════════════════════════
    %% EDGES
    %% ══════════════════════════════════════════════════

    USER <-->|HTTPS| FE

    %% Frontend ↔ Backend REST
    P_DASH <-->|GET sensor data| A_SEN
    P_WIZ  <-->|pipeline CRUD| A_PIP
    P_DET  <-->|pipeline CRUD| A_PIP
    P_SRC   -->|provision| A_PRO
    P_SRC   -->|cluster ops| A_CLU
    FE_CTX -.->|OAuth token| AUTH
    AUTH   -.->|validates| A_PIP
    AUTH   -.->|validates| WS_EP

    %% Frontend ↔ WebSocket
    WS_HOOK <-->|WebSocket frames| WS_EP
    BCAST   -->|real-time sensor frames| WS_HOOK

    %% WebSocket internal
    WS_EP --> BCAST

    %% IoT Simulator → Sinks
    SIM --> METRICS
    SIM -->|sensor events| SK_WS
    SIM -->|sensor events| SK_LB
    SIM -->|sensor events| SK_ZB

    %% Sinks → Storage / Clients
    SK_WS -->|broadcast 2 Hz| BCAST
    SK_LB -->|batch write| T_SEN
    SK_ZB -->|gRPC stream| DELTA

    %% API → Storage
    A_PIP <-->|CRUD| T_PIP
    A_SEN  -->|SELECT| T_SEN
    A_SEN  -->|SELECT| MV1
    A_SEN  -->|SELECT| MV2

    %% SSS flow
    SSS_SRC -->|read stream| SSS_JOB
    SSS_JOB -->|HTTP POST windowed aggs| A_SSS
    SSS_JOB --> SSS_FW
    SSS_FW  -->|write raw rows| T_SEN
    A_SSS   -->|WebSocket broadcast| BCAST

    %% Provisioning / Cluster mgmt
    A_PRO -->|provision| DBK_SDK
    A_CLU -->|cluster ops| DBK_SDK
    DBK_SDK -->|REST calls| DBK_API
    DBK_API -->|submit job| DBK_KAF
    A_PRO   -->|catalog · schema · volume| UC
    DELTA  -.->|governed by| UC

